{
  "name": "feroz/dynamic-db-bundle",
  "type": "symfony-bundle",
  "description": "Symfony bundle to manage dynamic database connections using Doctrine ORM.",
  "autoload": {
    "psr-4": {
      "Feroz\\DynamicDbBundle\\": "src/DynamicDbBundle/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Feroz\\DynamicDbBundle\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": ">=8.1",
    "doctrine/orm": "^2.2||^3.3",
    "symfony/framework-bundle": "^5.4 || ^6.0 || ^7.0",
    "doctrine/doctrine-bundle": "^2.8 || ^3.0",
    "symfony/yaml": "^5.4 || ^6.0 || ^7.0"
  },
  "license": "MIT",
  "authors": [
    {
      "name": "Saiful Feroz",
      "email": "saif012@gmail.com"
    }
  ],
  "minimum-stability": "stable",
  "prefer-stable": true,
  "require-dev": {
    "phpunit/phpunit": "^12.5",
    "symfony/phpunit-bridge": "^8.0"
  }
}
